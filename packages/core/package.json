{
  "name": "pixie-mascot",
  "version": "0.0.0",
  "description": "Deterministic pixel-art mascots from text: a 32x32 sprite generator with moods, motion and a web component",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./browser": "./dist/pixie.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "unpkg": "./dist/pixie.global.js",
  "jsdelivr": "./dist/pixie.global.js",
  "author": "dhri-yama",
  "homepage": "https://github.com/dhri-yama/pixie-mascot#readme",
  "bugs": {
    "url": "https://github.com/dhri-yama/pixie-mascot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhri-yama/pixie-mascot.git",
    "directory": "packages/core"
  },
  "keywords": [
    "pixel-art",
    "mascot",
    "avatar",
    "generator",
    "deterministic",
    "web-component",
    "sprite",
    "svg"
  ],
  "publishConfig": {
    "access": "public"
  }
}
