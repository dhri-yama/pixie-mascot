{
  "name": "pixie-mascot-react",
  "version": "0.0.0",
  "description": "React component for pixie-mascot: pixel-art mascots from text, with moods and motion",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pixie-mascot": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "author": "dhri-yama",
  "homepage": "https://github.com/dhri-yama/pixie-mascot#readme",
  "bugs": {
    "url": "https://github.com/dhri-yama/pixie-mascot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhri-yama/pixie-mascot.git",
    "directory": "packages/react"
  },
  "keywords": [
    "pixel-art",
    "mascot",
    "avatar",
    "react",
    "component",
    "sprite"
  ],
  "publishConfig": {
    "access": "public"
  }
}
