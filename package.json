{
  "name": "pixie-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "golden:update": "node --experimental-strip-types scripts/golden.ts",
    "variety": "node --experimental-strip-types scripts/variety.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
